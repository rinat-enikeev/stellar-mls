# Domain configuration
DOMAIN=onym.chat

# Let's Encrypt email (required for SSL certificates)
CERTBOT_EMAIL=contact@programyzer.com

# Digital Ocean deployment (only needed for deploy.sh)
DO_API_KEY=
CF_API_TOKEN=
DO_REGION=ams3
DO_DROPLET_SIZE=s-2vcpu-4gb
SSH_KEY_PATH=~/.ssh/id_ed25519

# Stellar relayer credentials are configured separately in relayer/.env
# See relayer/.env.example for the template
