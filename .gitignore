# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.DS_Store
.claude

# XCFramework build output (binary artifacts). build/* rather than
# build/ so individual subtrees can be re-included below.
build/*
# ...but the dev-env tree is source, not a build artifact. Secrets
# inside it are handled by build/dev-env/.gitignore.
!build/dev-env/

# Gradle / Kotlin build outputs anywhere in the tree
# (root `build/*` is anchored, so it doesn't catch kotlin-mls/build,
# clients/android/StellarChat/build, or app/build).
# Uses `build/*` shape (not `build/`) so git still descends into the
# directory and the dev-env re-include below stays effective.
**/build/*
!build/dev-env/

# Xcode
DerivedData/
*.xcuserdata
xcuserdata/

# Android
*.apk
*.aab
local.properties
.kotlin/
.gradle/
/.cargo/config.toml
**/google-services.json
**/fcm-service-account.json
**/google-play-secret.json

# Relayer secrets
.env
relayer/.env

# Generated build-time defaults from relayer/.env
clients/ios/StellarChat/StellarChat/RelayerDefaults.generated.swift

# Certbot generated data
deploy/certbot/conf/
deploy/certbot/webroot/

# Production env
.env.production

# Nostr signing keys (coordinator + admin) for the trusted-setup ceremony.
# The private scalars must never leave this machine; the directory is
# created by the operator and never committed.
.nostr/

# iOS App Store release automation
/clients/apple.env
/clients/fastlane/.appstoreconnect_api_key.json
/clients/fastlane/.export_options.plist
/clients/vendor/

# App Store review personal info
/clients/fastlane/metadata/review_information/first_name.txt
/clients/fastlane/metadata/review_information/last_name.txt
/clients/fastlane/metadata/review_information/phone_number.txt
/clients/fastlane/metadata/review_information/email_address.txt

# BIS encryption filing (personal data)
/clients/ios/onym-encryption.csv

# Google Play release automation
/clients/google.env
/clients/fastlane/.google_play_service_account.json

# Keyset proving keys (large binaries, already copied to app assets)
keyset-v*/*/proving_key.bin
keyset-v*/*/update_proving_key.bin

# AltStore PAL Alternative Distribution Packages (large notarized binaries, scp'd to onym.chat)
/deploy/website/adp/

# Browser WASM verifier build output — regenerated from crates/ceremony-wasm
# on every deploy, kept out of the repo (keep .gitkeep).
crates/ceremony-wasm/pkg/
/deploy/ceremony/wasm/*.wasm
/deploy/ceremony/wasm/*.js
/deploy/ceremony/wasm/*.d.ts
