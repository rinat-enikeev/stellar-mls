# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

.DS_Store
.claude

# XCFramework build output (binary artifacts)
build/

# Xcode
DerivedData/
*.xcuserdata
xcuserdata/

# Android
*.apk
*.aab
local.properties
.kotlin/
.gradle/
/.cargo/config.toml
**/google-services.json
**/fcm-service-account.json
**/google-play-secret.json

# Relayer secrets
.env
relayer/.env

# Generated build-time defaults from relayer/.env
clients/ios/StellarChat/StellarChat/RelayerDefaults.generated.swift

# Certbot generated data
deploy/certbot/conf/
deploy/certbot/webroot/

# Production env
.env.production

# iOS App Store release automation
/clients/apple.env
/clients/fastlane/.appstoreconnect_api_key.json
/clients/fastlane/.export_options.plist
/clients/vendor/

# App Store review personal info
/clients/fastlane/metadata/review_information/first_name.txt
/clients/fastlane/metadata/review_information/last_name.txt
/clients/fastlane/metadata/review_information/phone_number.txt
/clients/fastlane/metadata/review_information/email_address.txt

# BIS encryption filing (personal data)
/clients/ios/onym-encryption.csv

# Google Play release automation
/clients/google.env
/clients/fastlane/.google_play_service_account.json

# Keyset proving keys (large binaries, already copied to app assets)
keyset-v*/*/proving_key.bin
