# n8n env — copy to n8n.env. n8n stores its actual workflow + credential
# state in the n8n-data named volume, not here. These are bootstrap
# settings for the first run.

# Encrypt n8n's credentials-at-rest. Generate once:
#   openssl rand -hex 32
# If you ever change this after creating credentials, you lose access to
# them — keep it somewhere safe.
N8N_ENCRYPTION_KEY=REPLACE_ME

# Timezone for cron nodes.
GENERIC_TIMEZONE=UTC

# Basic auth on the n8n UI. Even though 5678 is bound to 127.0.0.1 and
# reached via ProxyJump, belt + suspenders.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=REPLACE_ME

# Public webhook URL — point this at your cloudflared tunnel / Tailscale
# funnel URL once you've set it up. GitHub App webhooks will POST here.
WEBHOOK_URL=https://REPLACE_ME.trycloudflare.com/

# Don't write telemetry pings.
N8N_DIAGNOSTICS_ENABLED=false

# Let IF / Code nodes read $env.* in expressions. Workflows 01/04/05/06
# need N8N_AGENT_MAP, N8N_BOT_LOGINS, etc. visible inside the evaluator.
# n8n defaults this to true (block) — we flip it.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# -- Agent round-trip mapping ------------------------------------------------
# Workflows 01/04/05/06 read these variables through Code nodes to route
# GitHub events to the right SSH target and back-post as the right bot.
# See docs/design-n8n-agent-round-trip.md for the full design.

# Mapping from GitHub login to agent container. JSON, one line.
#   role: "implementer" | "reviewer"
#   host, port, user: SSH target reachable from the n8n container
#   sshCredentialName: name of the n8n SSH credential used by that host's
#                      Switch branch (created in the n8n UI)
#   githubCredentialName: n8n GitHub App credential to post back with
# Keys must match GitHub logins exactly (case-sensitive in the payload, but
# GitHub normalises on the input side). The Switch node in each workflow
# needs one branch per unique `host` value here.
N8N_AGENT_MAP={"gramyzer":{"role":"implementer","host":"qa-agent","port":22,"user":"agent","sshCredentialName":"qa-agent SSH","githubCredentialName":"gramyzer GitHub"},"releaseng":{"role":"reviewer","host":"release-agent","port":22,"user":"agent","sshCredentialName":"release-agent SSH","githubCredentialName":"releaseng GitHub"}}

# Human QA login that receives the smoke-test issue after /merge.
N8N_HUMAN_QA_LOGIN=alexpovstin

# Fallbacks used when the trigger payload doesn't pin a specific agent.
N8N_IMPLEMENTER_DEFAULT=gramyzer
N8N_REVIEWER_DEFAULT=releaseng

# Comma-separated logins whose comments / events MUST NOT re-enter the
# round-trip. Must include every login in N8N_AGENT_MAP (even if the
# handle is normally a human) plus GitHub's own bot actors.
N8N_BOT_LOGINS=gramyzer,releaseng,github-actions[bot]

# Comma-separated list of logins authorised to post `/merge` comments.
N8N_MERGE_AUTHORIZED_LOGINS=alexpovstin,gramyzer

# Comma-separated logins allowed to issue free-text instructions to agents by
# @-mentioning an implementer login from N8N_AGENT_MAP in a PR comment. A
# commander in this list can comment e.g. "@gramyzer rename foo to bar" and
# workflow 05 routes the text (after stripping the mention) as the prompt to
# the mentioned agent. Includes agent logins on purpose so agents can
# delegate to each other; the @<login> + free-text pattern is what loop-proof
# templated bot comments never produce, so this does not enable loops.
N8N_COMMAND_USERS=rinat-enikeev,alexpovstin,innovesss,gramyzer,releaseng
