    "Extract issue fields": {
      "main": [[{ "node": "Encode prompt", "type": "main", "index": 0 }]]
    },
    "Encode prompt": {
      "main": [[{ "node": "Run claude in qa-agent", "type": "main", "index": 0 }]]
    },
    "Run claude in qa-agent": {
      "main": [[{ "node": "Comment on issue", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
