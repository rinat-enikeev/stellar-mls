    {
      "parameters": {
        "jsCode": "const body = $('Webhook').item.json.body;\nconst prev = $input.first().json;\nconst map = JSON.parse($env.N8N_AGENT_MAP || '{}');\nconst assignees = (body.issue.assignees || []).map(a => a.login);\nconst matchAssignee = assignees.find(a => map[a] && map[a].role === 'implementer');\nconst implementerLogin = matchAssignee || $env.N8N_IMPLEMENTER_DEFAULT;\nconst entry = map[implementerLogin];\nif (!entry) {\n  throw new Error(`N8N_AGENT_MAP has no implementer entry for login \"${implementerLogin}\"`);\n}\nconst reviewerLogin = $env.N8N_REVIEWER_DEFAULT;\nreturn [{ json: { ...prev, host: entry.host, sshPort: entry.port, sshUser: entry.user, implementerLogin, reviewerLogin } }];\n"
      },
      "id": "a1000000-0000-0000-0000-000000000007",
      "name": "Resolve implementer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [790, 220]
    },
    {
      "parameters": {
        "jsCode": "const j = $input.first().json;\nconst prompt = `Issue #${j.issueNumber}: ${j.issueTitle}\n\n${j.issueBody}\n\nImplement a fix. Keep the change minimal and focused on the reported problem. Commit with a clear message and exit when done.\n`;\nreturn [{ json: { ...j, promptB64: Buffer.from(prompt, 'utf8').toString('base64') } }];\n"
      },
