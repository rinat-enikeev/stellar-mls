              "leftValue": "={{ (() => { const body = $json.body; if (!['opened','reopened','labeled','assigned'].includes(body.action)) return false; if (body.sender && body.sender.type === 'Bot') return false; const botLogins = ($env.N8N_BOT_LOGINS || '').split(',').map(s => s.trim()).filter(Boolean); if (botLogins.includes(body.sender && body.sender.login)) return false; const labels = (body.issue.labels || []).map(l => l.name); if (labels.includes('agent-task')) return true; let map = {}; try { map = JSON.parse($env.N8N_AGENT_MAP || '{}'); } catch (e) { return false; } const assignees = (body.issue.assignees || []).map(a => a.login); return assignees.some(a => map[a] && map[a].role === 'implementer'); })() }}",
              "rightValue": true,
