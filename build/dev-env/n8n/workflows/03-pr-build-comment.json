    },
    "Get PR head SHA": {
      "main": [[{ "node": "Run build in qa-agent", "type": "main", "index": 0 }]]
    },
    "Run build in qa-agent": {
      "main": [[{ "node": "Post build result", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
