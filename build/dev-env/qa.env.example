# QA agent env — copy to qa.env, fill in, then `./bin/up.sh`.
# qa.env is gitignored. Never commit real tokens.

# GitHub — PAT or a GitHub App installation access token for the qa bot.
# Must have: contents:write, pull_requests:write, issues:write on this repo.
GITHUB_TOKEN=ghs_REPLACE_ME
GITHUB_REPO=rinat-enikeev/stellar-mls

# Claude Code — per-role API key, so QA and Release usage show up separately
# in your Anthropic billing.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Per-agent git identity shown on commits the agent makes.
GIT_COMMITTER_NAME=qa-agent
GIT_COMMITTER_EMAIL=qa-agent@stellar-mls.local

# Mac host delegation — the forced-command dispatcher that runs iOS +
# Android JNI builds on the Mac mini.
MAC_HOST=host.docker.internal
MAC_HOST_USER=stellar-builder
MAC_HOST_PORT=22

# iPhone pubkey for inbound SSH (ProxyJump via mac-host → this container).
# Generate on the iPhone in Blink: Settings → Keys → New (ed25519) → Copy
# public key. Paste the whole single-line ssh-ed25519 string here.
IPHONE_SSH_PUBKEY=
