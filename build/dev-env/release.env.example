# Release agent env — copy to release.env, fill in, then `./bin/up.sh`.
# release.env is gitignored. Never commit real tokens.

# GitHub — PAT or GitHub App installation token for the release bot.
# Must have: contents:write, pull_requests:read on this repo. Tags get
# pushed from here; the existing .github/workflows/release.yml does the
# actual build + upload on tag push. No signing secrets live in this
# container.
GITHUB_TOKEN=ghs_REPLACE_ME
GITHUB_REPO=rinat-enikeev/stellar-mls

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

GIT_COMMITTER_NAME=release-agent
GIT_COMMITTER_EMAIL=release-agent@stellar-mls.local

MAC_HOST=host.docker.internal
MAC_HOST_USER=stellar-builder
MAC_HOST_PORT=22

IPHONE_SSH_PUBKEY=
