# sshd config for stellar-mls dev-env agent containers.
# Hardened: key-only auth, no forwarding, single allowed user.

Port 22
Protocol 2

# Key-only authentication.
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
ChallengeResponseAuthentication no
UsePAM no
PermitEmptyPasswords no
AuthenticationMethods publickey

# Only the agent user can log in.
AllowUsers agent

# Expose build env to non-interactive SSH (UsePAM is off, so /etc/environment
# is not loaded; Debian bash skips ~/.bashrc for non-interactive shells). n8n
# drives builds via `ssh agent@qa-agent '<cmd>'` — these need to be visible.
SetEnv ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk

# No forwarding — prevents a compromised container from tunneling out.
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no

# Connection hygiene.
MaxAuthTries 3
LoginGraceTime 20
ClientAliveInterval 60
ClientAliveCountMax 3
MaxSessions 10

# Keep sftp available — useful for copying small artifacts back out.
Subsystem sftp /usr/lib/openssh/sftp-server

# Log to stderr so `docker logs` shows auth events.
SyslogFacility AUTH
LogLevel INFO

PrintMotd yes
