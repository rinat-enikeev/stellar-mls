# HTTP bind address for the Axum service
CEREMONY_BIND=0.0.0.0:9090

# SQLite database path (bind-mounted volume in production)
CEREMONY_DB_PATH=/app/data/ceremony.db

# Blossom blob server URL (content-addressed storage)
CEREMONY_BLOSSOM_URL=http://blossom:3000

# Public base URL for Blossom blobs (used in API responses)
CEREMONY_BLOSSOM_PUBLIC_URL=https://blossom.onym.chat

# Nostr relay (WebSocket) for transcript publication
CEREMONY_NOSTR_RELAY=ws://nostr-relay:7777

# Path to the ceremony_tool binary. Must be identical to the one participants download.
CEREMONY_TOOL_BIN=/usr/local/bin/ceremony_tool

# Scratch directory for subprocess state-dir handoff. Cleaned after every verify.
CEREMONY_WORK_DIR=/app/work

# Admin Nostr pubkeys allowed to freeze, skip, and publish Phase 2 rounds.
# Comma-separated hex pubkeys.
CEREMONY_ADMIN_PUBKEYS=

# Coordinator Nostr secret key (hex) for signing transcript events. KEEP SECRET.
CEREMONY_COORDINATOR_NSEC=

# Slot deadline per tier in seconds (default 2h)
CEREMONY_SLOT_DEADLINE_SECS=7200

# Minimum PoW difficulty (leading zero bits) on signup challenges
CEREMONY_POW_BITS=8

# Contribute-mode guardrails. NEVER set to true unless you understand the toxic-waste risk.
CEREMONY_ALLOW_BROWSER_CONTRIBUTE=false

# Per-endpoint rate limit (requests per minute per IP)
CEREMONY_RATE_LIMIT_RPM=60

# Path to the release manifest served at /api/v1/downloads.
# Fetched by the operator from the GitHub Release assets
# (see docs/rollout-doc.md §5b). Absent file → empty manifest.
CEREMONY_DOWNLOADS_MANIFEST=/app/data/ceremony-downloads.json

# Log filter
RUST_LOG=ceremony_coordinator=info,tower_http=info
