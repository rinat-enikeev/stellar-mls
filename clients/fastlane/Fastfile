default_platform(:ios)

platform :ios do
  desc "Build, upload to TestFlight, and export ad-hoc IPA"
  lane :release do
    setup_ci(force: true)

    app_store_connect_api_key(
      key_id: ENV['ASC_KEY_ID'],
      issuer_id: ENV['ASC_ISSUER_ID'],
      key_content: ENV['ASC_PRIVATE_KEY_P8'],
      is_key_content_base64: false,
      in_house: false
    )

    # App Store signing for TestFlight
    match(
      type: "appstore",
      app_identifier: ["chat.onym.ios", "chat.onym.ios.NotificationService"],
      readonly: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/StellarChat/StellarChat.xcodeproj",
      team_id: ENV['MATCH_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      targets: ["StellarChat"],
      profile_name: "match AppStore chat.onym.ios"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/StellarChat/StellarChat.xcodeproj",
      team_id: ENV['MATCH_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      targets: ["StellarChatNotificationService"],
      profile_name: "match AppStore chat.onym.ios.NotificationService"
    )

    # Build and export for App Store
    gym(
      project: "ios/StellarChat/StellarChat.xcodeproj",
      scheme: "StellarChat",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      archive_path: "build/ios/appstore/StellarChat.xcarchive",
      export_options: {
        signingStyle: "manual",
        teamID: ENV['MATCH_TEAM_ID'],
        provisioningProfiles: {
          "chat.onym.ios" => "match AppStore chat.onym.ios",
          "chat.onym.ios.NotificationService" => "match AppStore chat.onym.ios.NotificationService"
        }
      },
      xcargs: "COMPILER_INDEX_STORE_ENABLE=NO DEVELOPMENT_TEAM='#{ENV['MATCH_TEAM_ID']}'",
      output_directory: "build/ios/appstore",
      output_name: "StellarChat.ipa"
    )

    # Upload to TestFlight
    pilot(
      ipa: "build/ios/appstore/StellarChat.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )

    # Ad-hoc signing for AltStore / GitHub Release
    match(
      type: "adhoc",
      app_identifier: ["chat.onym.ios", "chat.onym.ios.NotificationService"],
      readonly: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/StellarChat/StellarChat.xcodeproj",
      team_id: ENV['MATCH_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      targets: ["StellarChat"],
      profile_name: "match AdHoc chat.onym.ios"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/StellarChat/StellarChat.xcodeproj",
      team_id: ENV['MATCH_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      targets: ["StellarChatNotificationService"],
      profile_name: "match AdHoc chat.onym.ios.NotificationService"
    )

    # Re-export the existing archive as ad-hoc
    gym(
      project: "ios/StellarChat/StellarChat.xcodeproj",
      scheme: "StellarChat",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "ad-hoc",
      skip_build_archive: true,
      archive_path: "build/ios/appstore/StellarChat.xcarchive",
      export_options: {
        signingStyle: "manual",
        teamID: ENV['MATCH_TEAM_ID'],
        provisioningProfiles: {
          "chat.onym.ios" => "match AdHoc chat.onym.ios",
          "chat.onym.ios.NotificationService" => "match AdHoc chat.onym.ios.NotificationService"
        }
      },
      output_directory: "build/ios/adhoc",
      output_name: "StellarChat.ipa"
    )
  end

  desc "Ad-hoc build for PR test builds — no TestFlight, no App Store"
  lane :build_local do
    setup_ci(force: true)

    match(
      type: "adhoc",
      app_identifier: ["chat.onym.ios", "chat.onym.ios.NotificationService"],
      readonly: true
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/StellarChat/StellarChat.xcodeproj",
      team_id: ENV['MATCH_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      targets: ["StellarChat"],
      profile_name: "match AdHoc chat.onym.ios"
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/StellarChat/StellarChat.xcodeproj",
      team_id: ENV['MATCH_TEAM_ID'],
      code_sign_identity: "Apple Distribution",
      targets: ["StellarChatNotificationService"],
      profile_name: "match AdHoc chat.onym.ios.NotificationService"
    )

    gym(
      project: "ios/StellarChat/StellarChat.xcodeproj",
      scheme: "StellarChat",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "ad-hoc",
      archive_path: "build/ios/adhoc/StellarChat.xcarchive",
      export_options: {
        signingStyle: "manual",
        teamID: ENV['MATCH_TEAM_ID'],
        provisioningProfiles: {
          "chat.onym.ios" => "match AdHoc chat.onym.ios",
          "chat.onym.ios.NotificationService" => "match AdHoc chat.onym.ios.NotificationService"
        }
      },
      xcargs: "COMPILER_INDEX_STORE_ENABLE=NO DEVELOPMENT_TEAM='#{ENV['MATCH_TEAM_ID']}'",
      output_directory: "build/ios/adhoc",
      output_name: "StellarChat.ipa",
      skip_package_dependencies_resolution: false
    )
  end
end
