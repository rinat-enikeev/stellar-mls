<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>onym</string>
			</array>
			<key>CFBundleURLName</key>
			<string>chat.onym.ios</string>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Onym needs camera access to scan QR codes for joining groups.</string>
	<key>NSContactsUsageDescription</key>
	<string>Onym uses your contacts to help you invite friends via Telegram. Your phonebook never leaves the device.</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>tg</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>onym.programyzer.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Onym needs photo library access to share encrypted images in group chats.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Onym needs microphone access to record voice messages.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>voip</string>
	</array>
</dict>
</plist>
