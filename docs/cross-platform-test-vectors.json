      },
      {
        "reason": "non-canonical c_new (all 0xFF is > Fr modulus r)",
        "wire_hex": "02255f5a330e7fb48a50a5b1a5fbce17b717aaad9861590025b53b3a1cf527010e0000000000000000ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
      }
