PN_BIND=0.0.0.0:8090
PN_NOSTR_RELAY=ws://nostr-relay:7777
PN_DATA_DIR=/app/data

# Apple Push Notification service (optional)
# Option A: path to .p8 file
APNS_KEY_PATH=/app/apns-key.p8
# Option B: raw PEM string (use \n for newlines)
# APNS_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIGT...your-key...\n-----END PRIVATE KEY-----
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=chat.onym.ios
APNS_ENVIRONMENT=production

# Firebase Cloud Messaging (optional)
FCM_SERVICE_ACCOUNT_PATH=/app/fcm-service-account.json
FCM_PROJECT_ID=

# Rate limiting
PN_RATE_LIMIT_SECONDS=5
