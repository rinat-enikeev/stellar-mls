# Stellar secret key for signing transactions (REQUIRED)
RELAYER_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Whitelisted SEP-XXXX contract ID (REQUIRED)
RELAYER_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC endpoint
RELAYER_RPC_URL=https://soroban.stellar.org

# Stellar network name
RELAYER_NETWORK=mainnet

# HTTP listen address
RELAYER_BIND=0.0.0.0:8080

# Comma-separated bearer tokens for authentication (empty = no auth)
RELAYER_AUTH_TOKENS=

# Rate limit: requests per minute per IP address
RELAYER_RATE_LIMIT=30

# Maximum request body size in bytes
RELAYER_MAX_PAYLOAD_SIZE=8192
