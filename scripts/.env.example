# Credentials for signing ceremony_tool binaries.
#
# Copy to scripts/.env (gitignored), fill in the values, then:
#   scripts/sign-macos.sh <binary>          — sign + notarize locally
#   scripts/sync-gh-secrets.sh              — mirror to GitHub Actions secrets
#
# Variable names here match GitHub Actions secret names exactly.
# See docs/ceremony-tool-signing.md for the full design + setup walkthrough.

# === Apple Developer ID (required for macOS notarization) ===

# Full identity from `security find-identity -v -p codesigning`.
APPLE_DEVELOPER_ID="Developer ID Application: Your Name (ABCD123456)"

# Just the team-id portion. Find at developer.apple.com (top-right).
APPLE_TEAM_ID=ABCD123456

# Apple ID email that owns the Developer ID cert.
APPLE_ID=you@example.com

# App-specific password from appleid.apple.com → Sign-In and Security.
# Format: xxxx-xxxx-xxxx-xxxx
APPLE_APP_PASSWORD=

# Base64-encoded .p12 export of the Developer ID Application cert.
# Required for CI; locally the cert lives in your Mac's login keychain
# so this can stay empty when running sign-macos.sh on your own Mac.
#   base64 -i cert.p12 | tr -d '\n'
APPLE_CERT_P12_BASE64=

# Password used when exporting the .p12.
APPLE_CERT_P12_PASSWORD=

# === minisign (optional — Linux/Windows artifact signatures) ===

# Base64-encoded ~/.minisign/minisign.key, single line.
#   minisign -G -p .minisign/ceremony-tool.pub -s .minisign/minisign.key
#   base64 -i .minisign/minisign.key | tr -d '\n'
MINISIGN_SECRET_KEY_BASE64=

MINISIGN_PASSWORD=
